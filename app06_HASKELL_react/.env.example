# Copy to .env and fill in real values. Never commit .env itself.
# These are the exact env var names both the Haskell backend (Config.hs)
# and scripts/local-dev-up.sh expect -- see backend/CLAUDE.md.

POSTGRES_DB=securevision
POSTGRES_USER=securevision
POSTGRES_PASSWORD=change-me

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=securevision
DB_USER=securevision
DB_PASSWORD=change-me

# HS256 shared secret, minimum 32 bytes. Dev-only value below -- override in
# every non-local environment.
JWT_SECRET=dev-only-secret-change-me-min-32-bytes
JWT_EXPIRATION_MINUTES=60

# Single hardcoded admin (no user table -- see backend/CLAUDE.md). Generate
# a bcrypt hash for ADMIN_PASSWORD_HASH; app01_react's hash format
# ($2b$/$2a$/$2y$) is directly interoperable with this backend.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=change-me-bcrypt-hash

PORT=8080
